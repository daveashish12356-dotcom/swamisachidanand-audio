<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".AudioPravachanFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/pravachan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ઓડિયો પ્રવચન"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pravachan_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_pravachan" />

        <TextView
            android:id="@+id/pravachan_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="હજુ સુધી કોઈ પ્રવચન ઉમેર્યું નથી."
            android:textColor="?attr/text_secondary"
            android:visibility="gone"
            android:paddingTop="8dp" />

        <ProgressBar
            android:id="@+id/pravachan_progress"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone"
            android:indeterminate="true"
            android:paddingTop="8dp" />

    </LinearLayout>

</FrameLayout>


