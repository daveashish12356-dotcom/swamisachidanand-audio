<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/audio_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/audio_nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background_light">

                <!-- Search Bar - global, same on all pages. Filter shown for Audio. -->
                <include
                    layout="@layout/layout_global_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/audio_search_bar_include" />

                <!-- Search results row (horizontal, single line) - immediately below search bar -->
                <TextView
                    android:id="@+id/audio_search_results_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:layout_marginBottom="8dp"
                    android:text="શોધ પરિણામો"
                    android:textSize="@dimen/section_title_size"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/audio_search_results_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_large"
                    android:paddingEnd="@dimen/spacing_large"
                    android:paddingBottom="@dimen/section_title_margin_bottom"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:visibility="gone"
                    tools:visibility="gone"
                    tools:listitem="@layout/item_audio_book_card_horizontal" />

                <!-- Category Chips - Books page jaisa -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/audio_category_chips_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/spacing_medium"
                    android:paddingEnd="@dimen/spacing_medium"
                    android:paddingBottom="@dimen/spacing_normal"
                    android:clipToPadding="false"
                    android:scrollbars="none" />

                <ProgressBar
                    android:id="@+id/audio_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <TextView
                    android:id="@+id/audio_error_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:padding="@dimen/spacing_large"
                    android:text="@string/audio_error"
                    android:textColor="?attr/text_primary"
                    android:textSize="16sp"
                    android:visibility="gone"
                    tools:visibility="gone" />

                <!-- Sections: each category = title + horizontal scroll; last section = બધાં ઓડિયો (grid, scroll 150+) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/audio_sections_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="24dp"
                    android:clipToPadding="false"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Banner ad at very bottom of Audio page -->
                <com.google.android.gms.ads.AdView
                    android:id="@+id/audio_bottom_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_large"
                    android:layout_marginEnd="@dimen/spacing_large"
                    android:layout_marginBottom="@dimen/spacing_xlarge"
                    android:visibility="gone"
                    app:adSize="BANNER"
                    app:adUnitId="@string/admob_banner_unit_id" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</FrameLayout>
