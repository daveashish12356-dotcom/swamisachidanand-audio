<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_large"
        android:paddingEnd="@dimen/spacing_large"
        android:paddingTop="@dimen/spacing_xlarge"
        android:paddingBottom="@dimen/spacing_xlarge">

        <!-- ફોટો + intro – પૂરા પેજ સાથે સ્ક્રોલ થાય -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/swami_info_header_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xlarge"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_large">

                <!-- પહેલા 10 સેકંડ આ ફોટો સ્થિર, પછી સ્લાઇડશો -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/swami_info_first_photo"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/swami_avatar"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/SwamiAvatarShape"
                        app:strokeColor="@color/deep_saffron"
                        app:strokeWidth="2dp"
                        android:contentDescription="@string/app_name" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/swami_info_slideshow_card"
                        android:layout_width="180dp"
                        android:layout_height="180dp"
                        android:layout_gravity="center_horizontal"
                        android:visibility="gone"
                        app:cardCornerRadius="90dp"
                        app:strokeColor="@color/deep_saffron"
                        app:strokeWidth="2dp">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/swami_info_photo_slideshow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Swami photo slideshow" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="સ્વામી સચ્ચિદાનંદ"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="જ. ૨૨ એપ્રિલ ૧૯૩૨, મુજપુર, જિ. પાટણ"
                    android:textSize="13sp"
                    android:textColor="?attr/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="@string/swami_intro"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:text="ભક્તિ નિકેતન આશ્રમ · દંતાલી, ઊંઝા, કોબા (ગાંધીનગર)"
                    android:textSize="13sp"
                    android:textColor="@color/deep_saffron"
                    android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

        <!-- જીવન (Life) - Gujarati Vishwakosh -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="જીવન — પ્રારંભિક જીવન અને આધ્યાત્મિક વિકાસ"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_early_life"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_early_life"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_spiritual"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- રચનાઓ (Works) - Gujarati Vishwakosh -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swami_literature_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_literature"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- સન્માન (Honours) - Gujarati Vishwakosh -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swami_awards_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_awards"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- વિચારધારા (Philosophy) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swami_philosophy_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_philosophy"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="સ્રોત: ગુજરાતી વિશ્વકોશ"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorTertiary"
                    android:fontStyle="italic" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- સામાજિક પ્રયાસો -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_large"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swami_social_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_social"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- વારસો અને પ્રભાવ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/swami_legacy_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:text="@string/swami_legacy"
                    android:textSize="14sp"
                    android:textColor="?attr/text_secondary"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- પુસ્તક ઓર્ડર સંપર્ક – સંદર્ભમાં સૌથી નીચે -->
        <include
            android:id="@+id/book_order_include_swami"
            layout="@layout/layout_book_order_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <!-- ફોટા ગેલેરી – પુસ્તકોની લિંક સાથે જ નીચે -->
        <TextView
            android:id="@+id/swami_view_more_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_large"
            android:layout_marginEnd="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_large"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="📷 બધા ફોટા જોવા માટે અહીં ક્લિક કરો"
            android:textSize="15sp"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <!-- Banner ad at very bottom of Swami info page -->
        <com.google.android.gms.ads.AdView
            android:id="@+id/swami_bottom_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_xlarge"
            android:visibility="gone"
            app:adSize="BANNER"
            app:adUnitId="ca-app-pub-7592986107944664/4541738286" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

