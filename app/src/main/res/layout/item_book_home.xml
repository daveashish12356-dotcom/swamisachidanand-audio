<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/book_home_card_width"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/book_home_card_margin_h"
    android:layout_marginEnd="@dimen/book_home_card_margin_h"
    android:layout_marginBottom="@dimen/book_home_card_margin_h"
    app:cardCornerRadius="@dimen/book_home_card_radius"
    app:cardElevation="4dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="@android:color/transparent"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@null">

    <!-- Compact 3D-style cover with title overlay (Popular section) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/book_home_card_thumbnail_height">

        <ImageView
            android:id="@+id/book_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:background="@drawable/book_placeholder"
            android:contentDescription="Book thumbnail" />

        <TextView
            android:id="@+id/book_online_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/year_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="ઓનલાઇન"
            android:textColor="@color/bhagva"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Bottom gradient + title (YouTube Shorts style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_book_title_gradient">

            <TextView
                android:id="@+id/book_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/book_home_card_title_size"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Hidden year view so adapter IDs stay valid -->
        <TextView
            android:id="@+id/book_year"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>

