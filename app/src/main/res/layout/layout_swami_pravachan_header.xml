<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swami_pravachan_header_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/swami_pravachan_header_avatar"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/swami_avatar"
                android:scaleType="centerCrop"
                android:contentDescription="@string/app_name"
                app:shapeAppearanceOverlay="@style/SwamiAvatarShape" />
        </FrameLayout>

        <TextView
            android:id="@+id/swami_pravachan_header_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="સ્વામી સચ્ચિદાનંદ"
            android:textColor="?attr/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/swami_pravachan_header_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="ભક્તિ નિકેતન આશ્રમ · દંતાલી, ઊંઝા, કોબા (ગાંધીનગર)"
            android:textColor="@color/deep_saffron"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

