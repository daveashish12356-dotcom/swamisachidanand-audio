<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dainik_category_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/card_background"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:strokeWidth="2dp"
    tools:strokeColor="#E65100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/dainik_category_color_block"
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:minHeight="72dp"
            tools:background="#E65100" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@null"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pravachan_swami"
            android:background="@drawable/pravachan_item_image_bg" />

        <TextView
            android:id="@+id/dainik_category_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="માનસગંગા" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
