<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/pravachan_item_bg"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/pravachan_item_image"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pravachan_swami"
            android:contentDescription="@string/nav_audio_pravachan"
            android:background="@drawable/pravachan_item_image_bg"
            android:padding="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/pravachan_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/pravachan_item_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/text_secondary"
                android:textSize="12sp"
                android:paddingTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pravachan_item_play"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="▶"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:background="@drawable/pravachan_item_play_bg"
            android:padding="4dp" />

    </LinearLayout>

</LinearLayout>

