<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_audio_header_gradient"
    android:padding="20dp">

    <TextView
        android:id="@+id/pravachan_player_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="પ્રવચન"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/text_primary"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="18dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_player_card"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pravachan_player_time_current"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="@color/bhagva"
                android:textStyle="bold"
                android:gravity="end" />

            <SeekBar
                android:id="@+id/pravachan_player_seek"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/bhagva"
                android:thumbTint="@color/bhagva" />

            <TextView
                android:id="@+id/pravachan_player_time_total"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="12sp"
                android:textColor="#757575"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <ImageButton
                android:id="@+id/pravachan_player_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/play_button_gradient"
                android:padding="18dp"
                android:contentDescription="@string/audio_play"
                android:src="@android:drawable/ic_media_play"
                android:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

