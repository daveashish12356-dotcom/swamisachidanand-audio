<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="54dp"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/tour_page_icon"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerInside"
        android:background="@drawable/bg_social_icon_circle"
        android:padding="18dp"
        android:src="@drawable/ic_nav_home"
        android:contentDescription="Tour icon" />

    <TextView
        android:id="@+id/tour_page_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="પેજ શીર્ષક"
        android:textStyle="bold"
        android:textColor="#222222"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tour_page_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="અહીં આ પેજ વિશે માહિતી આવશે."
        android:textColor="#444444"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>

