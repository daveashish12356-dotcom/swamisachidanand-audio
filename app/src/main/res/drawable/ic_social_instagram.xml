<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Radial gradient background -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="24dp"
                android:height="24dp" />
            <gradient
                android:type="radial"
                android:centerX="0.3"
                android:centerY="1.07"
                android:startColor="#fdf497"
                android:endColor="#285AEB"
                android:gradientRadius="24" />
        </shape>
    </item>

    <!-- White camera icon on top -->
    <item android:drawable="@drawable/ic_social_instagram_camera" />

</layer-list>

